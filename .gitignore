tests/coverage/
tests/.vite/
tests/__baseline__/ab-*.json
tests/__baseline__/current-run*.json
tests/__baseline__/full-run.log

# Pack / large local artifacts
*.tgz
9router-*.tgz

# Local DB from dev/test runs
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Secrets & credentials (never commit)
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
**/secrets/

# next.js
/.next/
/.next-cli-build/
/out/
cli/.build-home/
product
